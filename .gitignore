# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/privacy-results/

# Real privacy fixtures may contain identifying metadata. Keep their directory
# structure, but never commit the files placed inside it.
/tests/privacy/fixtures/real/**
!/tests/privacy/fixtures/real/**/
!/tests/privacy/fixtures/real/**/.gitkeep

# next.js
/.next/
/.next-privacy/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / wrangler
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Cloudflare Pages header rules - replaces the headers() function that used to
# live in next.config.ts. headers() doesn't run under `output: export` since
# there's no Next.js server in production, so this is the equivalent.
# https://developers.cloudflare.com/pages/configuration/headers/

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=86400
